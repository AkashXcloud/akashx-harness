{
  "name": "@akashx/akx-acp",
  "description": "Automation-only Agent Client Protocol server for driving AkashX Harness agents over JSON-RPC stdio",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@akashx/akx-brand": "workspace:^",
    "@akashx/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-attachment": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-mcp-client": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-session-persistence": "workspace:^",
    "@akashx/akx-token-meter": "workspace:^",
    "@akashx/akx-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@akashx/akx-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-agent-loop": "workspace:^",
    "@akashx/akx-agent-loop-testkit": "workspace:^",
    "@akashx/akx-attachment": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-mcp-client": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-session-persistence": "workspace:^",
    "@akashx/akx-session-persistence-jsonl": "workspace:^",
    "@akashx/akx-session-projection": "workspace:^",
    "@akashx/akx-token-meter": "workspace:^",
    "@akashx/akx-tools": "workspace:^",
    "@akashx/akx-user-approval": "workspace:^"
  }
