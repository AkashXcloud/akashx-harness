{
  "name": "@akashx/akx-fs-local",
  "description": "Local-filesystem implementation of the AkashX Harness filesystem seam (ctx.fs)",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
