{
  "name": "@akashx/akx-client-ui-cost",
  "description": "What a session cost in money: configured per-model rates applied to the tokens it and the deployment spent",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/client/ui-cost"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "akx": {
    "client": {
      "inject": [
        "@akashx/akx-api-remotes",
        "@akashx/akx-client-locale",
        "@akashx/akx-client-ui-chat",
        "@akashx/akx-client-ui-conversation",
        "@akashx/akx-client-ui-settings",
        "@akashx/akx-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@akashx/cordis": "workspace:^"
  },
  "devDependencies": {
    "@akashx/akx-api-session-controller": "workspace:^",
    "@akashx/akx-client-locale": "workspace:^",
    "@akashx/akx-client-ui-chat": "workspace:^",
    "@akashx/akx-client-ui-conversation": "workspace:^",
    "@akashx/akx-client-ui-primitives": "workspace:^",
    "@akashx/akx-client-ui-settings": "workspace:^",
    "@akashx/akx-client-ui-slots": "workspace:^",
    "@akashx/akx-settings": "workspace:^",
    "@akashx/akx-token-meter": "workspace:^",
    "@akashx/akx-tool-cognate": "workspace:^",
    "@akashx/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
