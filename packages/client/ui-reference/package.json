{
  "name": "@akashx/akx-client-ui-reference",
  "description": "Unified Web @file and @session reference source",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/client/ui-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "akx": {
    "client": {
      "inject": [
        "@akashx/akx-api-remotes",
        "@akashx/akx-api-session-controller",
        "@akashx/akx-client-connection",
        "@akashx/akx-client-locale",
        "@akashx/akx-client-ui-input-trigger",
        "@akashx/akx-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@akashx/cordis": "workspace:^"
  },
  "devDependencies": {
    "@akashx/akx-api-remotes": "workspace:^",
    "@akashx/akx-api-session-controller": "workspace:^",
    "@akashx/akx-client-connection": "workspace:^",
    "@akashx/akx-client-locale": "workspace:^",
    "@akashx/akx-client-test-runtime": "workspace:^",
    "@akashx/akx-client-ui-input-trigger": "workspace:^",
    "@akashx/akx-client-ui-primitives": "workspace:^",
    "@akashx/akx-client-ui-slots": "workspace:^",
    "@akashx/akx-file-reference": "workspace:^",
    "@akashx/akx-session-reference": "workspace:^",
    "@akashx/akx-typert-protocol": "workspace:^",
    "@akashx/akx-util-workspace-path": "workspace:^",
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-client-ui-sidebar-right": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
