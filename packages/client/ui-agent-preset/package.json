{
  "name": "@akashx/akx-client-ui-agent-preset",
  "description": "Agent-preset surfaces: the default for later sessions, this session's seat, and the composition editor",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/client/ui-agent-preset"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "akx": {
    "client": {
      "inject": [
        "@akashx/akx-api-session-controller",
        "@akashx/akx-client-connection",
        "@akashx/akx-client-locale",
        "@akashx/akx-client-ui-conversation",
        "@akashx/akx-client-ui-session",
        "@akashx/akx-client-ui-settings",
        "@akashx/akx-client-ui-workspace",
        "@akashx/akx-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@akashx/cordis": "workspace:^"
  },
  "devDependencies": {
    "@akashx/akx-api-remotes": "workspace:^",
    "@akashx/akx-api-session-controller": "workspace:^",
    "@akashx/akx-agent-presets": "workspace:^",
    "@akashx/akx-client-connection": "workspace:^",
    "@akashx/akx-client-locale": "workspace:^",
    "@akashx/akx-client-store": "workspace:^",
    "@akashx/akx-client-test-runtime": "workspace:^",
    "@akashx/akx-client-ui-conversation": "workspace:^",
    "@akashx/akx-client-ui-primitives": "workspace:^",
    "@akashx/akx-client-ui-settings": "workspace:^",
    "@akashx/akx-client-ui-slots": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@types/react": "~18.3.1",
    "@akashx/cordis": "workspace:^",
    "react": "^18.2.0",
    "@akashx/akx-client-ui-renderer": "workspace:^",
    "@akashx/akx-client-ui-session": "workspace:^",
    "@akashx/akx-client-ui-workspace": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
