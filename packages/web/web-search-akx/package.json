    "@akashx/akx-settings": "workspace:^"
  },
  "dependencies": {
    "@akashx/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-credentials": "workspace:^",
    "@akashx/akx-credentials-local": "workspace:^",
    "@akashx/akx-launch-environment": "workspace:^",
