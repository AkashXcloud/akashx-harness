{
  "name": "@akashx/akx-bash-sandbox",
  "description": "Sandbox-consuming implementation of the AkashX Harness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@akashx/akx-shell": "workspace:^",
    "@akashx/akx-bash-local": "workspace:^",
    "@akashx/akx-sandbox": "workspace:^",
    "@akashx/akx-sandbox-policy": "workspace:^",
    "@akashx/cordis": "workspace:^"
  },
  "devDependencies": {
    "@akashx/akx-shell": "workspace:^",
    "@akashx/akx-bash-local": "workspace:^",
    "@akashx/akx-subprocess-local": "workspace:^",
    "@akashx/akx-sandbox": "workspace:^",
    "@akashx/akx-sandbox-local": "workspace:^",
    "@akashx/akx-sandbox-policy": "workspace:^",
    "@akashx/cordis": "workspace:^",
    "@akashx/node-addon-system": "workspace:^",
    "@akashx/akx-session-projection": "workspace:^"
  }
}
