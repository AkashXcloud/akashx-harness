    "@akashx/akx-commands": "workspace:^",
    "@akashx/akx-file-reference": "workspace:^",
    "@akashx/akx-fs": "workspace:^",
    "@akashx/akx-jobs": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-native-command": "workspace:^",
    "@akashx/akx-scope": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-session-persistence": "workspace:^",
    "@akashx/akx-session-projection": "workspace:^",
    "@akashx/akx-session-projection-cache": "workspace:^",
    "@akashx/akx-session-query": "workspace:^",
