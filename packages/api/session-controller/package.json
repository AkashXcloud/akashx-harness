    "@akashx/akx-typert-protocol": "workspace:^",
    "@akashx/akx-typert-registry": "workspace:^",
    "@akashx/akx-util-time": "workspace:^",
    "@akashx/akx-util-values": "workspace:^",
    "@akashx/akx-util-workspace-path": "workspace:^",
    "@akashx/akx-workspace": "workspace:^"
  },
  "peerDependenciesMeta": {
