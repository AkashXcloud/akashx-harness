{
  "name": "@akashx/akx-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "akx": {
    "client": {
      "inject": [
        "@akashx/akx-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@akashx/akx-deque": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-util-values": "workspace:^",
    "@akashx/akx-api-cognate-controller": "workspace:^"
  },
  "peerDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-scope": "workspace:^"
  },
  "devDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-agent-presets": "workspace:^",
    "@akashx/akx-api-gateway": "workspace:^",
    "@akashx/akx-api-settings-controller": "workspace:^",
    "@akashx/akx-api-workspace-controller": "workspace:^",
    "@akashx/akx-commands": "workspace:^",
    "@akashx/akx-cordis-host-runner": "workspace:^",
    "@akashx/akx-credentials": "workspace:^",
    "@akashx/akx-file-reference": "workspace:^",
    "@akashx/akx-goal": "workspace:^",
    "@akashx/akx-host-plugin-inventory": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-message-feedback": "workspace:^",
    "@akashx/akx-session-reference": "workspace:^",
    "@akashx/akx-settings": "workspace:^",
    "@akashx/akx-subagent": "workspace:^",
    "@akashx/akx-user-approval": "workspace:^",
    "@akashx/akx-user-questions": "workspace:^",
    "@akashx/akx-client-connection": "workspace:^",
    "@akashx/akx-client-file-upload": "workspace:^",
    "@akashx/akx-typert-protocol": "workspace:^",
    "@akashx/akx-scope": "workspace:^",
    "@akashx/akx-api-session-controller": "workspace:^",
    "@akashx/akx-api-workspace-files": "workspace:^",
    "zod": "^4.4.3",
    "@akashx/akx-command-feedback": "workspace:^",
    "@akashx/akx-api-cognate-controller": "workspace:^"
  }
}
