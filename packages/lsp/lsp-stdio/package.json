{
  "name": "@akashx/akx-lsp-stdio",
  "description": "Generic stdio language-server provider for the AkashX Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-brand": "workspace:^",
    "@akashx/akx-fs": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-lsp": "workspace:^",
    "@akashx/akx-subprocess": "workspace:^",
    "@akashx/akx-timeout": "workspace:^"
  },
  "dependencies": {
    "@akashx/akx-util-values": "workspace:^",
    "@akashx/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-brand": "workspace:^",
    "@akashx/akx-fs": "workspace:^",
    "@akashx/akx-fs-local": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-lsp": "workspace:^",
    "@akashx/akx-subprocess": "workspace:^",
    "@akashx/akx-subprocess-local": "workspace:^",
    "@akashx/akx-timeout": "workspace:^",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
