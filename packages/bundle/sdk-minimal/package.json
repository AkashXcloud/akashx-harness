{
  "name": "@akashx/akx-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one AkashX adapter, persistent shell, and JSONL sessions",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "akx": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@akashx/cordis-plugin-timer": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-agent-loop": "workspace:^",
    "@akashx/akx-llm-api-extensions": "workspace:^",
    "@akashx/akx-invariants": "workspace:^",
    "@akashx/akx-jobs-local": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-llm-akx": "workspace:^",
    "@akashx/akx-llm-retry": "workspace:^",
    "@akashx/akx-plugin-package-inventory": "workspace:^",
    "@akashx/akx-sandbox-local": "workspace:^",
    "@akashx/akx-sandbox-policy": "workspace:^",
    "@akashx/akx-scope": "workspace:^",
    "@akashx/akx-sdk-app": "workspace:^",
    "@akashx/akx-sdk-jsonrpc-server": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-session-log-akx": "workspace:^",
    "@akashx/akx-session-persistence-jsonl": "workspace:^",
    "@akashx/akx-session-projection": "workspace:^",
    "@akashx/akx-session-title": "workspace:^",
    "@akashx/akx-subprocess-local": "workspace:^",
    "@akashx/akx-system-prompt": "workspace:^",
    "@akashx/akx-terminal": "workspace:^",
    "@akashx/akx-terminal-bash": "workspace:^",
    "@akashx/akx-tool-bash-persistent": "workspace:^",
    "@akashx/akx-tool-pwsh-persistent": "workspace:^",
    "@akashx/akx-tools": "workspace:^"
  },
  "peerDependencies": {
    "@akashx/cordis": "workspace:^"
  },
  "devDependencies": {
    "@akashx/cordis": "workspace:^"
  }
}
