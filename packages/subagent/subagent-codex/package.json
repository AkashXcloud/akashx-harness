{
  "name": "@akashx/akx-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "akx": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-subagent": "workspace:^",
    "@akashx/akx-subprocess": "workspace:^",
    "@akashx/akx-timeout": "workspace:^"
  },
  "dependencies": {
    "@akashx/akx-brand": "workspace:^",
    "@akashx/akx-sdk-protocol": "workspace:^",
    "@akashx/schemastery": "workspace:^",
    "@openai/codex": "0.153.4"
  },
  "devDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/cordis-plugin-loader": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-app-boot": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-loader-smoke": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-session-checkpoint-policy": "workspace:^",
    "@akashx/akx-session-persistence-jsonl": "workspace:^",
    "@akashx/akx-session-projection": "workspace:^",
    "@akashx/akx-subagent": "workspace:^",
    "@akashx/akx-subprocess": "workspace:^",
    "@akashx/akx-subprocess-local": "workspace:^",
    "@akashx/akx-timeout": "workspace:^",
    "@akashx/akx-tool-jobs": "workspace:^",
    "@akashx/akx-tool-subagent": "workspace:^",
    "@akashx/akx-tools": "workspace:^"
  }
}
