{
  "name": "@akashx/akx-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the AkashX Harness",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "presets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@akashx/cordis-plugin-include": "workspace:^",
    "@akashx/cordis-plugin-loader": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-atomic-write": "workspace:^",
    "@akashx/akx-invariants": "workspace:^",
    "@akashx/akx-home-paths": "workspace:^",
    "@akashx/akx-scope": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-session-projection": "workspace:^",
    "@akashx/akx-settings": "workspace:^",
    "@akashx/akx-system-prompt": "workspace:^",
    "@akashx/akx-tools": "workspace:^",
    "@akashx/akx-cognate": "workspace:^",
    "@akashx/akx-cognate-mysql": "workspace:^",
    "@akashx/akx-tool-cognate": "workspace:^",
    "@akashx/akx-typert-protocol": "workspace:^",
    "@akashx/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@akashx/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@akashx/cordis-plugin-group": "workspace:^",
    "@akashx/cordis-plugin-include": "workspace:^",
    "@akashx/cordis-plugin-loader": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-agent-loop": "workspace:^",
    "@akashx/akx-atomic-write": "workspace:^",
    "@akashx/akx-invariants": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-home-paths": "workspace:^",
    "@akashx/akx-scope": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-session-projection": "workspace:^",
    "@akashx/akx-settings": "workspace:^",
    "@akashx/akx-settings-file": "workspace:^",
    "@akashx/akx-system-prompt": "workspace:^",
    "@akashx/akx-tools": "workspace:^",
    "@akashx/akx-typert-protocol": "workspace:^",
    "@akashx/cordis": "workspace:^"
  }
}
