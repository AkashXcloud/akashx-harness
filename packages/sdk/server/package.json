{
  "name": "@akashx/akx-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process AkashX Harness SDK clients",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@akashx/akx-brand": "workspace:^",
    "@akashx/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-attachment": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-llm-akx": "workspace:^",
    "@akashx/akx-scope": "workspace:^",
    "@akashx/akx-sdk-protocol": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-subagent": "workspace:^"
  },
  "devDependencies": {
    "@akashx/cordis": "workspace:^",
    "@akashx/cordis-plugin-loader": "workspace:^",
    "@akashx/akx-agent": "workspace:^",
    "@akashx/akx-agent-loop": "workspace:^",
    "@akashx/akx-agent-loop-testkit": "workspace:^",
    "@akashx/akx-attachment": "workspace:^",
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-llm-akx": "workspace:^",
    "@akashx/akx-scope": "workspace:^",
    "@akashx/akx-sdk-protocol": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/akx-session-persistence-jsonl": "workspace:^",
    "@akashx/akx-session-projection": "workspace:^",
    "@akashx/akx-subagent": "workspace:^"
  }
}
