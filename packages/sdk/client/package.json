{
  "name": "@akashx/akx-sdk-client",
  "description": "TypeScript client SDK for driving a AkashX Harness runtime subprocess over stdio JSON-RPC: the AkashXHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashx-ai/akx-harness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@akashx/akx": "workspace:*"
  },
  "peerDependencies": {
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-sdk-protocol": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/cordis": "workspace:^"
  },
  "devDependencies": {
    "@akashx/akx-llm": "workspace:^",
    "@akashx/akx-sdk-protocol": "workspace:^",
    "@akashx/akx-session": "workspace:^",
    "@akashx/cordis": "workspace:^"
  }
}
